import sys

@extern("malloc")
def _os_malloc(size: int) -> addr[u8]:
    pass

@extern("realloc")
def _os_realloc(p: addr[u8], size: int) -> addr[u8]:
    pass

@extern("free")
def _os_free(p: addr[u8]) -> None:
    pass

@extern("popen")
def _os_popen(cmd: addr[u8], mode: addr[u8]) -> addr[u8] | None:
    pass

@extern("fread")
def _os_fread(ptr: addr[u8], size: int, nmemb: int, stream: addr[u8]) -> int:
    pass

@extern("pclose")
def _os_pclose(stream: addr[u8]) -> i32:
    pass

@extern("system")
def _os_libc_system(cmd: addr[u8]) -> i32:
    pass

@extern("access")
def _os_libc_access(path: addr[u8], mode: i32) -> i32:
    pass

@extern("mkdir")
def _os_libc_mkdir(path: addr[u8], mode: i32) -> i32:
    pass

@extern("opendir")
def _os_opendir(path: addr[u8]) -> addr[u8] | None:
    pass

@extern("readdir")
def _os_readdir(dirp: addr[u8]) -> addr[u8] | None:
    pass

@extern("closedir")
def _os_closedir(dirp: addr[u8]) -> i32:
    pass

@extern("getenv")
def _os_libc_getenv(name: addr[u8]) -> addr[u8] | None:
    pass

@extern("getcwd")
def _os_libc_getcwd(buf: addr[u8], size: int) -> addr[u8] | None:
    pass

@extern("unlink")
def _os_libc_unlink(path: addr[u8]) -> i32:
    pass

@extern("rename")
def _os_libc_rename(oldpath: addr[u8], newpath: addr[u8]) -> i32:
    pass

@extern("open")
def _os_libc_open(path: addr[u8], flags: i32, mode: i32) -> i32:
    pass

@extern("close")
def _os_libc_close(fd: i32) -> i32:
    pass

@extern("fsync")
def _os_libc_fsync(fd: i32) -> i32:
    pass

@extern("pread")
def _os_libc_pread(fd: i32, buf: addr[u8], count: int, offset: i64) -> int:
    pass

@extern("pwrite")
def _os_libc_pwrite(fd: i32, buf: addr[u8], count: int, offset: i64) -> int:
    pass

@extern("symlink")
def _os_libc_symlink(target: addr[u8], linkpath: addr[u8]) -> i32:
    pass

def system(cmd: str) -> int:
    st = int(_os_libc_system(cmd.bin))
    if st < 0:
        return -1
    if (st & 127) == 0:
        return (st >> 8) & 255
    return -1

def exec(cmd: str) -> tuple[int, str]:
    fp = _os_popen(cmd.bin, "r".bin)
    if fp is None:
        return (-1, "")
    cap = 4096
    length = 0
    buf = _os_malloc(cap)
    while True:
        avail = cap - length - 1
        if avail < 1024:
            cap *= 2
            buf = _os_realloc(buf, cap)
            avail = cap - length - 1
        n = _os_fread(buf + length, 1, avail, fp)
        if n <= 0:
            break
        length += n
    buf[length] = u8(0)
    st = int(_os_pclose(fp))
    rc = (st >> 8) & 255 if (st & 127) == 0 else -1
    out = unbin(buf)
    _os_free(buf)
    return (rc, out)

def exists(path: str) -> bool:
    return _os_libc_access(path.bin, i32(0)) == i32(0)

def isdir(path: str) -> bool:
    d = _os_opendir(path.bin)
    if d is None:
        return False
    _os_closedir(d)
    return True

def listdir(path: str) -> list[str]:
    out: list[str] = []
    d = _os_opendir(path.bin)
    if d is None:
        return out
    name_off = 21 if sys.platform == "darwin" else 19
    while True:
        ent = _os_readdir(d)
        if ent is None:
            break
        name = unbin(ent + name_off)
        if name != "." and name != "..":
            out.append(name)
    _os_closedir(d)
    return out

def getenv(name: str) -> str:
    p = _os_libc_getenv(name.bin)
    return unbin(p) if p is not None else ""

def getcwd() -> str:
    buf = _os_malloc(4096)
    p = _os_libc_getcwd(buf, 4096)
    res = unbin(p) if p is not None else ""
    _os_free(buf)
    return res

def remove(path: str) -> bool:
    return _os_libc_unlink(path.bin) == i32(0)

def rename(oldpath: str, newpath: str) -> bool:
    return _os_libc_rename(oldpath.bin, newpath.bin) == i32(0)

def open_fd(path: str, flags: i32, mode: i32 = i32(420)) -> i32:
    return _os_libc_open(path.bin, flags, mode)

def close_fd(fd: i32) -> bool:
    return _os_libc_close(fd) == i32(0)

def fsync(fd: i32) -> bool:
    return _os_libc_fsync(fd) == i32(0)

def pread(fd: i32, count: int, offset: i64) -> str:
    if count <= 0:
        return ""
    buf = _os_malloc(count + 1)
    n = _os_libc_pread(fd, buf, count, offset)
    if n <= 0:
        _os_free(buf)
        return ""
    val(buf + n) = u8(0)
    res = unbin(buf)
    _os_free(buf)
    return res

def pwrite(fd: i32, data: str, offset: i64) -> int:
    return _os_libc_pwrite(fd, data.bin, len(data), offset)

def symlink(target: str, linkpath: str) -> bool:
    return _os_libc_symlink(target.bin, linkpath.bin) == i32(0)

def mkdir(path: str) -> bool:
    if len(path) == 0:
        return False
    if _os_libc_mkdir(path.bin, i32(493)) == i32(0):
        return True
    return isdir(path)

def mkdir_p(path: str) -> bool:
    if len(path) == 0:
        return False
    cur = "/" if path.startswith("/") else ""
    for part in path.split("/"):
        if part == "" or part == ".":
            continue
        if cur == "" or cur == "/":
            cur = cur + part
        else:
            cur = cur + "/" + part
        if not mkdir(cur):
            return False
    return True

def path_join(a: str, b: str) -> str:
    if b.startswith("/") or a == "":
        return b.copy()
    if a.endswith("/"):
        return a + b
    return a + "/" + b

def basename(path: str) -> str:
    p = path.strip()
    if p == "/":
        return "/"
    while len(p) > 1 and p.endswith("/"):
        p = p[:len(p) - 1]
    parts = p.split("/")
    return parts[len(parts) - 1].copy()

def dirname(path: str) -> str:
    p = path.strip()
    if p == "/":
        return "/"
    while len(p) > 1 and p.endswith("/"):
        p = p[:len(p) - 1]
    parts = p.split("/")
    if len(parts) <= 1:
        return "."
    if len(parts) == 2 and parts[0] == "":
        return "/"
    kept: list[str] = []
    for i in range(len(parts) - 1):
        kept.append(parts[i].copy())
    return "/".join(kept)
