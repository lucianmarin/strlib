import math

assert math.isclose(math.sin(math.PI / 2.0), 1.0)
assert math.isclose(math.cos(0.0), 1.0)
assert math.isclose(math.sqrt(2.0) * math.sqrt(2.0), 2.0)
assert math.isclose(math.cbrt(27.0), 3.0)
assert math.isclose(math.pow(2.0, 10.0), 1024.0)
assert math.isclose(math.log(math.E), 1.0)
assert math.isclose(math.log(8.0, base=2.0), 3.0)
assert math.isclose(math.log10(1000.0), 3.0)
assert math.isclose(math.log2(256.0), 8.0)
assert math.ceil(2.1) == 3
assert math.floor(2.9) == 2
assert math.trunc(-2.9) == -2
assert math.isclose(math.fabs(-4.5), 4.5)
assert math.isclose(math.hypot(3.0, 4.0), 5.0)
assert math.isclose(math.radians(180.0), math.PI)
assert math.isclose(math.degrees(math.PI), 180.0)
assert math.isnan(math.NAN)
assert math.isinf(math.INF)
assert not math.isfinite(math.INF)
assert math.isfinite(42.0)
assert math.gcd(48, 18) == 6
assert math.lcm(12, 18) == 36
assert math.factorial(6) == 720
assert math.isclose(math.clamp(15.0, 0.0, 10.0), 10.0)
assert math.isclose(math.clamp(-5.0, 0.0, 10.0), 0.0)

print("MATH TESTS PASSED")
