import multiprocessing
import os

def _child_exit_42() -> int:
    return 42

def test_process_and_pipe() -> None:
    p = multiprocessing.Process(_child_exit_42)
    p.start()
    assert p.pid() > 0
    code = p.join()
    assert code == 42
    assert not p.is_alive()

    pipe = multiprocessing.Pipe()
    pipe.send("hello_mp")
    msg = pipe.recv(64)
    assert msg == "hello_mp"
    pipe.close()

_mp_shm_ptr: addr[i64] | None = None

def _inc_proc() -> int:
    p = _mp_shm_ptr
    if p is not None:
        i = 0
        while i < 1000:
            atomic_add(p, 1)
            i += 1
    return 0

def test_shared_memory_and_atomics() -> None:
    global _mp_shm_ptr
    shm = multiprocessing.SharedMemory(64)
    p = shm.ptr_i64()
    atomic_store(p, 0)
    _mp_shm_ptr = p

    c1 = multiprocessing.Process(_inc_proc)
    c2 = multiprocessing.Process(_inc_proc)
    c1.start()
    c2.start()
    assert c1.join() == 0
    assert c2.join() == 0
    assert atomic_load(p) == 2000
    _mp_shm_ptr = None
    shm.close()

def test_file_lock() -> None:
    path = "/tmp/stricta_mp_test.lock"
    fl = multiprocessing.FileLock(path)
    fl.lock_exclusive()
    fl.unlock()
    assert fl.try_lock_exclusive()
    fl.unlock()
    fl.close()
    os.remove(path)

test_process_and_pipe()
test_shared_memory_and_atomics()
test_file_lock()
print("test_multiprocessing: ok")
