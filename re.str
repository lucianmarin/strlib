# Regular expressions for Stricta (POSIX extended regex via libc @extern)

import sys

IGNORECASE: int = 2
MULTILINE: int = 4

@extern("malloc")
def _re_malloc_i64(size: int) -> addr[int]:
    pass

@extern("malloc")
def _re_malloc_i32(size: int) -> addr[i32]:
    pass

@extern("malloc")
def _re_malloc_u8(size: int) -> addr[u8]:
    pass

@extern("free")
def _re_free_i64(p: addr[int]) -> None:
    pass

@extern("free")
def _re_free_i32(p: addr[i32]) -> None:
    pass

@extern("free")
def _re_free_u8(p: addr[u8]) -> None:
    pass

@extern("regcomp")
def _re_regcomp(preg: addr[int], pattern: addr[u8], cflags: i32) -> i32:
    pass

@extern("regexec")
def _re_regexec64(preg: addr[int], text: addr[u8], nmatch: int, pmatch: addr[int], eflags: i32) -> i32:
    pass

@extern("regexec")
def _re_regexec32(preg: addr[int], text: addr[u8], nmatch: int, pmatch: addr[i32], eflags: i32) -> i32:
    pass

@extern("regerror")
def _re_regerror(errcode: i32, preg: addr[int], errbuf: addr[u8], errbuf_size: int) -> int:
    pass

@extern("regfree")
def _re_regfree(preg: addr[int]) -> None:
    pass

def _re_find(pattern: str, text: str, start_pos: int, flags: int) -> list[str]:
    res: list[str] = []
    if start_pos < 0 or start_pos > len(text):
        return res
    is_darwin = sys.platform == "darwin"
    cflags = 1
    if (flags & 2) != 0:
        cflags = cflags | 2
    if (flags & 4) != 0:
        cflags = cflags | (8 if is_darwin else 4)
    preg = _re_malloc_i64(64)
    rc = _re_regcomp(preg, pattern.bin, i32(cflags))
    if rc != i32(0):
        ebuf = _re_malloc_u8(256)
        _re_regerror(rc, preg, ebuf, 256)
        err_msg = unbin(ebuf)
        _re_free_u8(ebuf)
        _re_free_i64(preg)
        res.append("ERR:" + err_msg)
        return res
    nsub = preg[1] if is_darwin else preg[6]
    nmatch = nsub + 1
    eflags = i32(1 if start_pos > 0 else 0)
    sub_text = text[start_pos:]
    if is_darwin:
        pm64 = _re_malloc_i64(nmatch * 16)
        mrc = _re_regexec64(preg, sub_text.bin, nmatch, pm64, eflags)
        if mrc == i32(0):
            res.append(str(start_pos + pm64[0]))
            res.append(str(start_pos + pm64[1]))
            for i in range(nmatch):
                so = pm64[i * 2]
                eo = pm64[i * 2 + 1]
                if so < 0 or eo < so:
                    res.append("")
                else:
                    res.append(sub_text[so:eo])
        _re_free_i64(pm64)
    else:
        pm32 = _re_malloc_i32(nmatch * 8)
        mrc = _re_regexec32(preg, sub_text.bin, nmatch, pm32, eflags)
        if mrc == i32(0):
            res.append(str(start_pos + int(pm32[0])))
            res.append(str(start_pos + int(pm32[1])))
            for i in range(nmatch):
                so = int(pm32[i * 2])
                eo = int(pm32[i * 2 + 1])
                if so < 0 or eo < so:
                    res.append("")
                else:
                    res.append(sub_text[so:eo])
        _re_free_i32(pm32)
    _re_regfree(preg)
    _re_free_i64(preg)
    return res

class Match:
    _start: int
    _end: int
    _groups: list[str]

    def __init__(self, start_pos: int, end_pos: int, groups: list[str]) -> None:
        self._start = start_pos
        self._end = end_pos
        self._groups = groups

    def copy(self) -> Match:
        return Match(self._start, self._end, self._groups.copy())

    def group(self, idx: int = 0) -> str:
        if idx < 0 or idx >= len(self._groups):
            raise "IndexError: no such group"
        return self._groups[idx].copy()

    def groups(self) -> list[str]:
        out: list[str] = []
        for i in range(1, len(self._groups)):
            out.append(self._groups[i].copy())
        return out

    def start(self) -> int:
        return self._start

    def end(self) -> int:
        return self._end

    def span(self) -> tuple[int, int]:
        return (self._start, self._end)

def _run_find(pattern: str, text: str, pos: int, flags: int) -> Match | None:
    raw = _re_find(pattern, text, pos, flags)
    if len(raw) == 1 and raw[0].startswith("ERR:"):
        raise "ValueError: invalid regex: " + raw[0][4:]
    if len(raw) < 3:
        return None
    s = int(raw[0])
    e = int(raw[1])
    grps: list[str] = []
    for i in range(2, len(raw)):
        grps.append(raw[i].copy())
    return Match(s, e, grps)

class Pattern:
    pattern: str
    flags: int

    def __init__(self, pattern: str, flags: int = 0) -> None:
        # Validate regex upfront so compile() catches syntax errors immediately
        _ = _run_find(pattern, "", 0, flags)
        self.pattern = pattern
        self.flags = flags

    def copy(self) -> Pattern:
        return Pattern(self.pattern.copy(), self.flags)

    def search(self, text: str, pos: int = 0) -> Match | None:
        return _run_find(self.pattern, text, pos, self.flags)

    def match(self, text: str) -> Match | None:
        m = _run_find(self.pattern, text, 0, self.flags)
        if m is not None and m.start() == 0:
            return m
        return None

    def fullmatch(self, text: str) -> Match | None:
        m = _run_find(self.pattern, text, 0, self.flags)
        if m is not None and m.start() == 0 and m.end() == len(text):
            return m
        return None

    def finditer(self, text: str) -> list[Match]:
        out: list[Match] = []
        pos = 0
        n = len(text)
        while pos <= n:
            m = _run_find(self.pattern, text, pos, self.flags)
            if m is None:
                break
            e = m.end()
            out.append(m)
            if e == pos:
                pos += 1
            else:
                pos = e
        return out

    def findall(self, text: str) -> list[str]:
        matches = self.finditer(text)
        out: list[str] = []
        for m in matches:
            grps = m.groups()
            if len(grps) == 1:
                out.append(grps[0].copy())
            else:
                out.append(m.group(0))
        return out

    def sub(self, repl: str, text: str, count: int = 0) -> str:
        matches = self.finditer(text)
        if len(matches) == 0:
            return text.copy()
        parts: list[str] = []
        last = 0
        done = 0
        for m in matches:
            if count > 0 and done >= count:
                break
            parts.append(text[last:m.start()])
            parts.append(repl.copy())
            last = m.end()
            done += 1
        parts.append(text[last:])
        return "".join(parts)

    def split(self, text: str, maxsplit: int = 0) -> list[str]:
        matches = self.finditer(text)
        out: list[str] = []
        last = 0
        done = 0
        for m in matches:
            if maxsplit > 0 and done >= maxsplit:
                break
            out.append(text[last:m.start()])
            last = m.end()
            done += 1
        out.append(text[last:])
        return out

def compile(pattern: str, flags: int = 0) -> Pattern:
    return Pattern(pattern, flags)

def search(pattern: str, text: str, flags: int = 0) -> Match | None:
    return _run_find(pattern, text, 0, flags)

def match(pattern: str, text: str, flags: int = 0) -> Match | None:
    m = _run_find(pattern, text, 0, flags)
    if m is not None and m.start() == 0:
        return m
    return None

def fullmatch(pattern: str, text: str, flags: int = 0) -> Match | None:
    m = _run_find(pattern, text, 0, flags)
    if m is not None and m.start() == 0 and m.end() == len(text):
        return m
    return None

def finditer(pattern: str, text: str, flags: int = 0) -> list[Match]:
    p = Pattern(pattern, flags)
    return p.finditer(text)

def findall(pattern: str, text: str, flags: int = 0) -> list[str]:
    p = Pattern(pattern, flags)
    return p.findall(text)

def sub(pattern: str, repl: str, text: str, count: int = 0, flags: int = 0) -> str:
    p = Pattern(pattern, flags)
    return p.sub(repl, text, count)

def split(pattern: str, text: str, maxsplit: int = 0, flags: int = 0) -> list[str]:
    p = Pattern(pattern, flags)
    return p.split(text, maxsplit)

def escape(text: str) -> str:
    special = ".^$*+?{}[]\\|()"
    parts: list[str] = []
    for i in range(len(text)):
        ch = text[i:i + 1]
        if ch in special:
            parts.append("\\" + ch)
        else:
            parts.append(ch)
    return "".join(parts)
