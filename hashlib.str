# Cryptographic hashing for Stricta (pure-Stricta FIPS 180-4 SHA-256)

_K: list[u32] = [
    u32(0x428a2f98), u32(0x71374491), u32(0xb5c0fbcf), u32(0xe9b5dba5),
    u32(0x3956c25b), u32(0x59f111f1), u32(0x923f82a4), u32(0xab1c5ed5),
    u32(0xd807aa98), u32(0x12835b01), u32(0x243185be), u32(0x550c7dc3),
    u32(0x72be5d74), u32(0x80deb1fe), u32(0x9bdc06a7), u32(0xc19bf174),
    u32(0xe49b69c1), u32(0xefbe4786), u32(0x0fc19dc6), u32(0x240ca1cc),
    u32(0x2de92c6f), u32(0x4a7484aa), u32(0x5cb0a9dc), u32(0x76f988da),
    u32(0x983e5152), u32(0xa831c66d), u32(0xb00327c8), u32(0xbf597fc7),
    u32(0xc6e00bf3), u32(0xd5a79147), u32(0x06ca6351), u32(0x14292967),
    u32(0x27b70a85), u32(0x2e1b2138), u32(0x4d2c6dfc), u32(0x53380d13),
    u32(0x650a7354), u32(0x766a0abb), u32(0x81c2c92e), u32(0x92722c85),
    u32(0xa2bfe8a1), u32(0xa81a664b), u32(0xc24b8b70), u32(0xc76c51a3),
    u32(0xd192e819), u32(0xd6990624), u32(0xf40e3585), u32(0x106aa070),
    u32(0x19a4c116), u32(0x1e376c08), u32(0x2748774c), u32(0x34b0bcb5),
    u32(0x391c0cb3), u32(0x4ed8aa4a), u32(0x5b9cca4f), u32(0x682e6ff3),
    u32(0x748f82ee), u32(0x78a5636f), u32(0x84c87814), u32(0x8cc70208),
    u32(0x90befffa), u32(0xa4506ceb), u32(0xbef9a3f7), u32(0xc67178f2),
]

def _rotr(x: u32, n: u32) -> u32:
    return (x >> n) | (x << (u32(32) - n))

def _u32_to_hex(v: u32) -> str:
    digits = "0123456789abcdef"
    parts: list[str] = []
    for i in range(7, -1, -1):
        nib = int((v >> u32(i * 4)) & u32(0xF))
        parts.append(digits[nib:nib + 1])
    return "".join(parts)

def _sha256_raw(msg: list[int]) -> str:
    orig_len = len(msg)
    bit_len: u64 = u64(orig_len) * u64(8)

    # Pad: 0x80, then 0x00 until length % 64 == 56, then 8-byte big-endian bit length
    padded: list[int] = msg.copy()
    padded.append(0x80)
    while len(padded) % 64 != 56:
        padded.append(0)
    for shift in range(56, -1, -8):
        padded.append(int((bit_len >> u64(shift)) & u64(0xFF)))

    h0: u32 = u32(0x6a09e667)
    h1: u32 = u32(0xbb67ae85)
    h2: u32 = u32(0x3c6ef372)
    h3: u32 = u32(0xa54ff53a)
    h4: u32 = u32(0x510e527f)
    h5: u32 = u32(0x9b05688c)
    h6: u32 = u32(0x1f83d9ab)
    h7: u32 = u32(0x5be0cd19)

    w: list[u32] = [u32(0) for _ in range(64)]
    nblocks = len(padded) // 64
    for b in range(nblocks):
        base = b * 64
        for i in range(16):
            j = base + i * 4
            w[i] = (u32(padded[j]) << u32(24)) | (u32(padded[j + 1]) << u32(16)) | (u32(padded[j + 2]) << u32(8)) | u32(padded[j + 3])
        for i in range(16, 64):
            s0 = _rotr(w[i - 15], u32(7)) ^ _rotr(w[i - 15], u32(18)) ^ (w[i - 15] >> u32(3))
            s1 = _rotr(w[i - 2], u32(17)) ^ _rotr(w[i - 2], u32(19)) ^ (w[i - 2] >> u32(10))
            w[i] = w[i - 16] + s0 + w[i - 7] + s1

        a = h0
        bv = h1
        c = h2
        d = h3
        e = h4
        f = h5
        g = h6
        h = h7

        for i in range(64):
            S1 = _rotr(e, u32(6)) ^ _rotr(e, u32(11)) ^ _rotr(e, u32(25))
            ch = (e & f) ^ ((~e) & g)
            temp1 = h + S1 + ch + _K[i] + w[i]
            S0 = _rotr(a, u32(2)) ^ _rotr(a, u32(13)) ^ _rotr(a, u32(22))
            maj = (a & bv) ^ (a & c) ^ (bv & c)
            temp2 = S0 + maj

            h = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = bv
            bv = a
            a = temp1 + temp2

        h0 = h0 + a
        h1 = h1 + bv
        h2 = h2 + c
        h3 = h3 + d
        h4 = h4 + e
        h5 = h5 + f
        h6 = h6 + g
        h7 = h7 + h

    return (_u32_to_hex(h0) + _u32_to_hex(h1) + _u32_to_hex(h2) + _u32_to_hex(h3) +
            _u32_to_hex(h4) + _u32_to_hex(h5) + _u32_to_hex(h6) + _u32_to_hex(h7))

def sha256(text: str) -> str:
    bs: list[int] = []
    for i in range(len(text)):
        bs.append(ord(text[i:i + 1]))
    return _sha256_raw(bs)

def sha256_bytes(data: bytes) -> str:
    bs: list[int] = []
    for i in range(len(data)):
        bs.append(data[i])
    return _sha256_raw(bs)
