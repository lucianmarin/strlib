from typing import Callable

@extern("calloc")
def _th_calloc(nmemb: int, size: int) -> addr[u8]:
    pass

@extern("free")
def _th_free(p: addr[u8]) -> None:
    pass

@extern("pthread_create")
def _th_pthread_create(tid: addr[u64], attr: addr[u8] | None, start_routine: Callable[[addr[u8]], addr[u8] | None], arg: addr[u8] | None) -> i32:
    pass

@extern("pthread_join")
def _th_pthread_join(tid: u64, retval: addr[u8] | None) -> i32:
    pass

@extern("pthread_detach")
def _th_pthread_detach(tid: u64) -> i32:
    pass

@extern("pthread_self")
def _th_pthread_self() -> u64:
    pass

@extern("pthread_mutex_init")
def _th_mutex_init(m: addr[u8], attr: addr[u8] | None) -> i32:
    pass

@extern("pthread_mutex_destroy")
def _th_mutex_destroy(m: addr[u8]) -> i32:
    pass

@extern("pthread_mutex_lock")
def _th_mutex_lock(m: addr[u8]) -> i32:
    pass

@extern("pthread_mutex_trylock")
def _th_mutex_trylock(m: addr[u8]) -> i32:
    pass

@extern("pthread_mutex_unlock")
def _th_mutex_unlock(m: addr[u8]) -> i32:
    pass

@extern("pthread_cond_init")
def _th_cond_init(c: addr[u8], attr: addr[u8] | None) -> i32:
    pass

@extern("pthread_cond_destroy")
def _th_cond_destroy(c: addr[u8]) -> i32:
    pass

@extern("pthread_cond_wait")
def _th_cond_wait(c: addr[u8], m: addr[u8]) -> i32:
    pass

@extern("pthread_cond_signal")
def _th_cond_signal(c: addr[u8]) -> i32:
    pass

@extern("pthread_cond_broadcast")
def _th_cond_broadcast(c: addr[u8]) -> i32:
    pass

@extern("pthread_rwlock_init")
def _th_rwlock_init(rw: addr[u8], attr: addr[u8] | None) -> i32:
    pass

@extern("pthread_rwlock_destroy")
def _th_rwlock_destroy(rw: addr[u8]) -> i32:
    pass

@extern("pthread_rwlock_rdlock")
def _th_rwlock_rdlock(rw: addr[u8]) -> i32:
    pass

@extern("pthread_rwlock_tryrdlock")
def _th_rwlock_tryrdlock(rw: addr[u8]) -> i32:
